{
    "name": "terrasphere/cms",
    "description": "TerraSphere CMS application shell.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "terrasphere/core": "dev-main",
        "terrasphere/media": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "terrasphere/core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/media",
            "options": {
                "symlink": true,
                "versions": {
                    "terrasphere/media": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "extends/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test"
    }
}
