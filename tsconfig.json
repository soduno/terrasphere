{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@components": ["./packages/core/resources/js/components"],
            "@components/*": ["./packages/core/resources/js/components/*"],
            "@ui": ["./packages/core/resources/js/components/ui"],
            "@ui/*": ["./packages/core/resources/js/components/ui/*"]
        },
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "packages/core/resources/js/**/*.ts",
        "packages/core/resources/js/**/*.tsx",
        "vite.config.ts"
    ]
}
