{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@components": ["./packages/core/resources/js/components"],
            "@components/*": ["./packages/core/resources/js/components/*"],
            "@adapter": ["./packages/core/resources/js/adapter"],
            "@adapter/*": ["./packages/core/resources/js/adapter/*"],
            "@ui": ["./packages/core/resources/js/components/ui"],
            "@ui/*": ["./packages/core/resources/js/components/ui/*"],
            "@media": ["./packages/media/resources/js"],
            "@media/*": ["./packages/media/resources/js/*"],
            "@localization": ["./packages/localization/resources/js"],
            "@localization/*": ["./packages/localization/resources/js/*"]
        },
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "packages/core/resources/js/**/*.ts",
        "packages/core/resources/js/**/*.tsx",
        "packages/media/resources/js/**/*.ts",
        "packages/media/resources/js/**/*.tsx",
        "packages/localization/resources/js/**/*.ts",
        "packages/localization/resources/js/**/*.tsx",
        "vite.config.ts"
    ]
}
